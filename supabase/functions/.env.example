# Server-only shipping provider credentials. Never prefix these with VITE_.
EASYPOST_API_KEY=

# Required to request live carrier rates. All dimensions are inches; weight is
# ounces per kit and is multiplied by the server-verified cart kit count.
EASYPOST_FROM_NAME=Encore Bio Labs
EASYPOST_FROM_STREET1=
EASYPOST_FROM_STREET2=
EASYPOST_FROM_CITY=
EASYPOST_FROM_STATE=
EASYPOST_FROM_ZIP=
EASYPOST_FROM_COUNTRY=US
EASYPOST_FROM_PHONE=
EASYPOST_PARCEL_LENGTH_IN=
EASYPOST_PARCEL_WIDTH_IN=
EASYPOST_PARCEL_HEIGHT_IN=
EASYPOST_WEIGHT_OZ_PER_KIT=

# Comma-separated production site origins allowed to call the function.
STOREFRONT_ALLOWED_ORIGINS=

# Zoho Mail is called only from the communications Edge Function. SMTP values
# are retained for a future SMTP-capable worker; Supabase Edge uses Zoho's HTTPS
# Mail API because raw SMTP sockets are not available in this runtime.
#
# Host note: this file previously documented smtp.zoho.com, but the live
# Supabase Auth SMTP configuration uses smtppro.zoho.com (required for paid
# Zoho Mail / custom-domain accounts). smtppro.zoho.com is authoritative; keep
# any SMTP-capable worker on the same host as Supabase Auth.
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=support@encorebiolabs.com
ZOHO_SMTP_PASSWORD=
ZOHO_FROM_EMAIL=support@encorebiolabs.com
ZOHO_MAIL_ACCOUNT_ID=

# Zoho OAuth (HTTPS Mail API). Access tokens expire after ~1 hour, so the
# function exchanges the long-lived refresh token for one at call time and
# caches it in memory. Create a self-client in the Zoho API Console with the
# ZohoMail.messages.CREATE scope; the refresh token does not expire unless it
# is revoked or the client secret is rotated.
# ZOHO_OAUTH_ACCESS_TOKEN is REMOVED — a static access token can never work for
# more than an hour and must not be set.
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_REFRESH_TOKEN=
# Zoho data-center accounts host. Use accounts.zoho.eu / .in / .com.au etc. if
# the mailbox lives outside the US data center. Defaults to accounts.zoho.com.
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com

# OpenAI, used only by the draft-followup Edge Function to write CRM follow-up
# messages. Server-side only — never expose this through a VITE_ variable, or
# the key ships inside the browser bundle for anyone to read. The function is
# admin-gated and never sends a message; an operator reviews every draft.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Public production origin used only to build Supabase Auth invitation redirects.
# Do not include a trailing slash.
PORTAL_SITE_URL=https://encorebiolabs.com

# The server centers each 10-mile radius on the approved distribution postal
# code: El Paso 79912, Juarez 32510, Chihuahua 31200. Pickup is free and
# verified home delivery is fixed at $10. Missing point details or timing
# intentionally trigger manual review.
LOCAL_DELIVERY_EL_PASO_HOME_DELIVERY_TIME=
LOCAL_DELIVERY_EL_PASO_PICKUP_NAME=
LOCAL_DELIVERY_EL_PASO_PICKUP_ADDRESS=
LOCAL_DELIVERY_EL_PASO_PICKUP_TIME=

LOCAL_DELIVERY_JUAREZ_HOME_DELIVERY_TIME=
LOCAL_DELIVERY_JUAREZ_PICKUP_NAME=
LOCAL_DELIVERY_JUAREZ_PICKUP_ADDRESS=
LOCAL_DELIVERY_JUAREZ_PICKUP_TIME=

LOCAL_DELIVERY_CHIHUAHUA_HOME_DELIVERY_TIME=
LOCAL_DELIVERY_CHIHUAHUA_PICKUP_NAME=
LOCAL_DELIVERY_CHIHUAHUA_PICKUP_ADDRESS=
LOCAL_DELIVERY_CHIHUAHUA_PICKUP_TIME=
